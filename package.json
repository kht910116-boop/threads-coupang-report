{
  "name": "autotube-studio",
  "productName": "AutoTube Studio",
  "version": "0.1.0",
  "private": true,
  "description": "스타일 프리셋 기반 유튜브 영상 기획·에셋 생성·캡컷 내보내기 도구 (개인용)",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "app": "npm run build && npm run prepare:standalone && electron .",
    "pack": "npm run build && npm run prepare:standalone && electron-builder --win dir",
    "dist": "npm run build && npm run prepare:standalone && electron-builder --win nsis"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "next": "^16.3.4",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
