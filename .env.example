# ── 기획 엔진 ─────────────────────────────────────────────────
# 둘 중 하나만 있으면 된다.
#
#  [구독제] Claude Pro/Max — API 키가 없어도 된다.
#    Claude Code를 설치하고 `claude` 실행 → /login 으로 구독 계정 로그인 한 번.
#    그러면 아래 키 없이도 돌아간다. PATH에 없으면 CLAUDE_CLI_PATH로 지정.
#
#  [종량제] Anthropic API 키
#    ANTHROPIC_API_KEY를 넣으면 API를 직접 쓴다.
#
# 비워두면 자동 선택: API 키가 있으면 API, 없으면 CLI.
# cli / api 로 못박을 수 있다.
#  [구독 웹] 브라우저 자동화
#    CLI가 없는 서비스(ChatGPT, Gemini, Perplexity …)는 백그라운드 브라우저로 돌린다.
#    전용 프로파일을 쓰므로 평소 쓰는 브라우저는 건드리지 않고, 헤드리스라 창도 안 뜬다.
#    연결 상태 화면에서 '로그인'을 한 번 누르면 그때만 창이 뜬다.
#
# 특정 엔진으로 고정하려면 id를 넣는다 (claude, codex, chatgpt, gemini, api …).
PLANNER_AGENT=
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# 웹 자동화가 쓸 브라우저. 비우면 설치된 크롬을 쓴다.
# BROWSER_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# ── TTS: 쓰는 것만 채우면 된다. 프리셋에서 컷마다 골라 쓴다 ──────
# ElevenLabs — https://elevenlabs.io  (Profile → API Key)
ELEVENLABS_API_KEY=

# Typecast — https://typecast.ai
TYPECAST_API_KEY=
# 계정/플랜에 따라 엔드포인트가 다르면 여기서 덮어쓴다
TYPECAST_API_BASE=https://api.typecast.ai

# Google AI Studio (Gemini TTS) — https://aistudio.google.com/apikey
GOOGLE_AI_STUDIO_API_KEY=

# Google Cloud Text-to-Speech — API 키 방식
GOOGLE_CLOUD_TTS_API_KEY=

# ── 이미지 생성 ────────────────────────────────────────────────
# 비워두면 '수동' 모드: 프롬프트만 뽑아주고 이미지는 직접 넣는다
GEMINI_IMAGE_API_KEY=
OPENAI_API_KEY=

# ── 영상 생성 (컷별 video 모드) ────────────────────────────────
GEMINI_VIDEO_API_KEY=

# ── 저장 위치 (기본: ./data) ───────────────────────────────────
# AUTOTUBE_DATA_DIR=/absolute/path/to/data

# ── 캡컷 드래프트 폴더 (내보내기 대상) ─────────────────────────
# macOS 예시
# CAPCUT_DRAFT_DIR=/Users/me/Movies/CapCut/User Data/Projects/com.lveditor.draft
# Windows 예시
# CAPCUT_DRAFT_DIR=C:\Users\me\AppData\Local\CapCut\User Data\Projects\com.lveditor.draft
